[
  {
    "id": "version-shrink",
    "contract": "versioned_index",
    "group": "target",
    "coverage": "新片段更少时清除旧片段",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "doc",
          "version": 3,
          "body": "政策 旧甲\n政策 旧乙\n政策 旧丙"
        },
        {
          "op": "import",
          "document_id": "doc",
          "version": 9,
          "body": "政策 新版"
        },
        {
          "op": "query",
          "query": "政策",
          "limit": 5
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "政策",
          "answer": "政策 新版",
          "citations": [
            {
              "chunk_id": "doc:9:0",
              "document_id": "doc",
              "version": 9
            }
          ]
        }
      ],
      "versions": {
        "doc": 9
      },
      "chunks": [
        {
          "chunk_id": "doc:9:0",
          "document_id": "doc",
          "version": 9,
          "position": 0,
          "text": "政策 新版"
        }
      ]
    }
  },
  {
    "id": "version-old-keyword",
    "contract": "versioned_index",
    "group": "target",
    "coverage": "只匹配旧正文关键词时无旧命中",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "alpha",
          "version": 10,
          "body": "过期专属 旧规则"
        },
        {
          "op": "import",
          "document_id": "alpha",
          "version": 12,
          "body": "生效专属 新规则"
        },
        {
          "op": "query",
          "query": "过期专属",
          "limit": 1
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "过期专属",
          "answer": "未找到相关内容",
          "citations": []
        }
      ],
      "versions": {
        "alpha": 12
      },
      "chunks": [
        {
          "chunk_id": "alpha:12:0",
          "document_id": "alpha",
          "version": 12,
          "position": 0,
          "text": "生效专属 新规则"
        }
      ]
    }
  },
  {
    "id": "version-isolation",
    "contract": "versioned_index",
    "group": "target",
    "coverage": "多文档隔离与完整替换",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "a",
          "version": 2,
          "body": "policy alpha"
        },
        {
          "op": "import",
          "document_id": "b",
          "version": 8,
          "body": "policy beta"
        },
        {
          "op": "import",
          "document_id": "c",
          "version": 1,
          "body": "policy gamma"
        },
        {
          "op": "import",
          "document_id": "b",
          "version": 11,
          "body": "policy beta_new"
        },
        {
          "op": "query",
          "query": "policy",
          "limit": 9
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "policy",
          "answer": "policy alpha\npolicy beta_new\npolicy gamma",
          "citations": [
            {
              "chunk_id": "a:2:0",
              "document_id": "a",
              "version": 2
            },
            {
              "chunk_id": "b:11:0",
              "document_id": "b",
              "version": 11
            },
            {
              "chunk_id": "c:1:0",
              "document_id": "c",
              "version": 1
            }
          ]
        }
      ],
      "versions": {
        "a": 2,
        "b": 11,
        "c": 1
      },
      "chunks": [
        {
          "chunk_id": "a:2:0",
          "document_id": "a",
          "version": 2,
          "position": 0,
          "text": "policy alpha"
        },
        {
          "chunk_id": "b:11:0",
          "document_id": "b",
          "version": 11,
          "position": 0,
          "text": "policy beta_new"
        },
        {
          "chunk_id": "c:1:0",
          "document_id": "c",
          "version": 1,
          "position": 0,
          "text": "policy gamma"
        }
      ]
    }
  },
  {
    "id": "version-repeat",
    "contract": "versioned_index",
    "group": "regression",
    "coverage": "相同版本内容重复导入幂等",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "x",
          "version": 4,
          "body": "rule first"
        },
        {
          "op": "import",
          "document_id": "x",
          "version": 4,
          "body": "rule first"
        },
        {
          "op": "query",
          "query": "rule",
          "limit": 4
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "rule",
          "answer": "rule first",
          "citations": [
            {
              "chunk_id": "x:4:0",
              "document_id": "x",
              "version": 4
            }
          ]
        }
      ],
      "versions": {
        "x": 4
      },
      "chunks": [
        {
          "chunk_id": "x:4:0",
          "document_id": "x",
          "version": 4,
          "position": 0,
          "text": "rule first"
        }
      ]
    }
  },
  {
    "id": "version-delayed",
