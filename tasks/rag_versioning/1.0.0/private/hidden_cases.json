        {
          "op": "reopen"
        },
        {
          "op": "query",
          "query": "query",
          "limit": 1
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "query",
          "answer": "query current",
          "citations": [
            {
              "chunk_id": "persist:9:0",
              "document_id": "persist",
              "version": 9
            }
          ]
        }
      ],
      "versions": {
        "persist": 9
      },
      "chunks": [
        {
          "chunk_id": "persist:9:0",
          "document_id": "persist",
          "version": 9,
          "position": 0,
          "text": "query current"
        }
      ]
    }
  },
  {
    "id": "version-empty-first",
