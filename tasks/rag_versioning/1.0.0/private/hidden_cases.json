      "versions": {
        "late": 20
      },
      "chunks": [
        {
          "chunk_id": "late:20:0",
          "document_id": "late",
          "version": 20,
          "position": 0,
          "text": "rule current"
        }
      ]
    }
  },
  {
    "id": "version-empty",
    "contract": "versioned_index",
    "group": "target",
    "coverage": "空正文清除且保留版本，拒绝低版本，重开一致",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "empty",
          "version": 1,
          "body": "旧片段 保留测试"
        },
        {
          "op": "import",
          "document_id": "other",
          "version": 3,
          "body": "独立规则"
        },
        {
          "op": "import",
          "document_id": "empty",
          "version": 6,
          "body": ""
        },
        {
          "op": "import",
          "document_id": "empty",
          "version": 2,
          "body": "迟到旧片段"
        },
        {
          "op": "reopen"
        },
        {
          "op": "query",
          "query": "旧片段",
          "limit": 1
        },
        {
          "op": "query",
          "query": "独立规则",
          "limit": 1
        }
      ]
    },
    "expected": {
      "queries": [
        {
          "query": "旧片段",
          "answer": "未找到相关内容",
          "citations": []
        },
        {
          "query": "独立规则",
          "answer": "独立规则",
          "citations": [
            {
              "chunk_id": "other:3:0",
              "document_id": "other",
              "version": 3
            }
          ]
        }
      ],
      "versions": {
        "empty": 6,
        "other": 3
      },
      "chunks": [
        {
          "chunk_id": "other:3:0",
          "document_id": "other",
          "version": 3,
          "position": 0,
          "text": "独立规则"
        }
      ]
    }
  },
  {
    "id": "version-reopen",
    "contract": "versioned_index",
    "group": "target",
    "coverage": "更新关闭重开后仍为新版本",
    "input": {
      "actions": [
        {
          "op": "import",
          "document_id": "persist",
          "version": 5,
          "body": "query old"
        },
        {
          "op": "import",
          "document_id": "persist",
          "version": 9,
          "body": "query current"
